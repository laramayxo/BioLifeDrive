# Copy to .env locally. On Railway, set these as Variables on the service.
# Railway automatically provides DATABASE_URL when you add a Postgres service
# and link it with a reference variable.
DATABASE_URL=postgres://postgres:password@localhost:5432/biolifedrive
PORT=3000
# Optional: enables real AI companion replies. Without it, the companion
# uses a built-in, story-grounded fallback that never pretends to be the person.
OPENAI_API_KEY=
# Optional: AdSense publisher ID, filled in after AdSense approves biolifedrive.com
ADSENSE_CLIENT_ID=
# Stripe is NOT wired in this copy. Connect Stripe separately when its
# live account is activated; do not put live keys in the repo.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
